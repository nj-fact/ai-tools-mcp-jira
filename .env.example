# Configuration is layered: process environment < .env < .envrc.
# Both files are re-read on every CLI command and MCP tool call, so edits take
# effect on the next call without restarting the server. See README.md for which
# .envrc lines are honoured (assignments, source_env/dotenv includes, unset).

# Jira Cloud site URL, for example:
# JIRA_SITE_URL=https://your-domain.atlassian.net
JIRA_SITE_URL=https://your-domain.atlassian.net

# Atlassian account email address used for Jira.
JIRA_EMAIL=you@example.com

# Atlassian API token.
# Create one at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-api-token

# Read-only smoke tests should stay inside the FC queue/project.
JIRA_TEST_JQL=project = FC AND updated >= -365d ORDER BY updated DESC

# Test issue creation stays in the FC project by default.
JIRA_TEST_PROJECT_KEY=FC
JIRA_TEST_ISSUE_TYPE=Task
JIRA_TEST_ISSUE_KEY=FC-123

# Write actions are blocked unless the issue belongs to one of these projects
# or the issue key is explicitly listed.
JIRA_WRITE_PROJECT_KEYS=FC
JIRA_WRITE_ISSUE_KEYS=
JIRA_AUDIT_LOG_PATH=.jira-agent/audit.jsonl

# Jira custom field holding story points. The numeric id differs per Jira site;
# look it up under /rest/api/3/field if the default does not apply.
JIRA_STORY_POINTS_FIELD=customfield_10028

# --- Per-project credential overrides (optional) ---
# Some Jira projects require a different user/API token. Override credentials per
# project key with JIRA_PROJECT__<PROJECTKEY>__EMAIL and JIRA_PROJECT__<PROJECTKEY>__API_TOKEN.
# The project key is case-insensitive in the variable name and normalized to uppercase.
# EMAIL and API_TOKEN must both be set for a project; SITE_URL is optional and
# falls back to JIRA_SITE_URL. All other requests keep using the default credentials.
# JIRA_PROJECT__FINRP__EMAIL=finrp-user@example.com
# JIRA_PROJECT__FINRP__API_TOKEN=finrp-api-token
# JIRA_PROJECT__FINRP__SITE_URL=https://your-domain.atlassian.net
